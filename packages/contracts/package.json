{
  "name": "@alloc/contracts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "schema:export": "npm run build && node dist/export-json-schema.js",
    "schema:check": "npm run schema:export && git diff --exit-code -- schemas"
  },
  "dependencies": {
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
