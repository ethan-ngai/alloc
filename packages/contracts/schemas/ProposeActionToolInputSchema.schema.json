{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "requestRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "type": {
      "type": "string",
      "enum": [
        "simulate_purchase",
        "request_human_review",
        "cancel_request"
      ]
    },
    "amount": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidenceRefs": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "requestId",
    "requestRevision",
    "type",
    "rationale",
    "evidenceRefs"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/ProposeActionToolInputSchema.schema.json",
  "title": "ProposeActionToolInputSchema",
  "x-alloc-contract-version": "1.0.0"
}
