{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^org_[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        }
      },
      "required": [
        "schemaVersion",
        "organizationId",
        "correlationId"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "subjectRef": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        },
        "relationshipTypes": {
          "default": [],
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxHops": {
          "default": 2,
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maxEntities": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "asOf": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "subjectRef"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "payload"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/GetGraphContextInputSchema.schema.json",
  "title": "GetGraphContextInputSchema",
  "x-alloc-contract-version": "1.0.0"
}
