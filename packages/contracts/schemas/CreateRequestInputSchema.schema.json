{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0.0"
        },
        "organizationId": {
          "type": "string",
          "pattern": "^org_[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "commandId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "causationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "expectedVersions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              },
              "expectedRevision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "ref",
              "expectedRevision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "organizationId",
        "commandId",
        "correlationId",
        "expectedVersions"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "requesterId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "fullAmount": {
          "type": "object",
          "properties": {
            "amountMinor": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "currency": {
              "type": "string",
              "const": "USD"
            }
          },
          "required": [
            "amountMinor",
            "currency"
          ],
          "additionalProperties": false
        },
        "categoryId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "vendorId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        },
        "scopes": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "organization",
                  "department",
                  "project",
                  "category",
                  "location",
                  "vendor",
                  "employee",
                  "customer",
                  "asset",
                  "contract",
                  "legal_entity",
                  "account"
                ]
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "requesterId",
        "purpose",
        "fullAmount",
        "categoryId",
        "scopes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "meta",
    "payload"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/CreateRequestInputSchema.schema.json",
  "title": "CreateRequestInputSchema",
  "x-alloc-contract-version": "1.0.0"
}
