{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "organization",
        "department",
        "project",
        "category",
        "location",
        "vendor",
        "employee",
        "customer",
        "asset",
        "contract",
        "legal_entity",
        "account"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    }
  },
  "required": [
    "type",
    "id"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/ScopeRefSchema.schema.json",
  "title": "ScopeRefSchema",
  "x-alloc-contract-version": "1.0.0"
}
