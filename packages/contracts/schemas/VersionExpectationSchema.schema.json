{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ref": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "expectedRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "ref",
    "expectedRevision"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/VersionExpectationSchema.schema.json",
  "title": "VersionExpectationSchema",
  "x-alloc-contract-version": "1.0.0"
}
