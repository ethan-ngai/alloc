{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "organizationId": {
      "type": "string",
      "pattern": "^org_[a-z0-9]+(?:_[a-z0-9]+)*$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "causationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "expectedVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "additionalProperties": false
          },
          "expectedRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "ref",
          "expectedRevision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "organizationId",
    "commandId",
    "correlationId",
    "expectedVersions"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/CommandMetaSchema.schema.json",
  "title": "CommandMetaSchema",
  "x-alloc-contract-version": "1.0.0"
}
