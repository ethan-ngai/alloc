{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "evidence": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "string",
            "const": "1.0.0"
          },
          "organizationId": {
            "type": "string",
            "pattern": "^org_[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "evidenceId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "kind": {
            "type": "string",
            "enum": [
              "source_record",
              "document_excerpt",
              "metric",
              "decision_precedent"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "type": "object",
            "properties": {
              "classification": {
                "type": "string",
                "enum": [
                  "public",
                  "internal",
                  "confidential",
                  "restricted"
                ]
              },
              "scopeRefs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "organization",
                        "department",
                        "project",
                        "category",
                        "location",
                        "vendor",
                        "employee",
                        "customer",
                        "asset",
                        "contract",
                        "legal_entity",
                        "account"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                }
              },
              "allowedPrincipalIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
                }
              }
            },
            "required": [
              "classification",
              "scopeRefs"
            ],
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "synthetic",
                  "imported",
                  "live"
                ]
              },
              "trust": {
                "type": "string",
                "enum": [
                  "authoritative",
                  "evidence",
                  "candidate"
                ]
              },
              "sourceInstanceId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
              },
              "sourceObjectId": {
                "type": "string",
                "minLength": 1
              },
              "sourceRevision": {
                "type": "string",
                "minLength": 1
              },
              "occurredAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "observedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            },
            "required": [
              "kind",
              "trust",
              "sourceInstanceId",
              "sourceObjectId",
              "sourceRevision",
              "occurredAt",
              "observedAt"
            ],
            "additionalProperties": false
          },
          "authoritativeFor": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "schemaVersion",
          "organizationId",
          "evidenceId",
          "revision",
          "kind",
          "title",
          "content",
          "access",
          "provenance",
          "authoritativeFor"
        ],
        "additionalProperties": false
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "evidence",
    "truncated",
    "continuation"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/SearchEvidenceToolResultSchema.schema.json",
  "title": "SearchEvidenceToolResultSchema",
  "x-alloc-contract-version": "1.0.0"
}
