{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
    },
    "effect": {
      "type": "string",
      "enum": [
        "permit",
        "deny",
        "require_review"
      ]
    },
    "categoryIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
      }
    },
    "requesterRoles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "maximumFullAmount": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "maximumCumulativeIncrease": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "requireActivePurpose": {
      "type": "boolean"
    },
    "requiredEvidenceKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eligibleVendorIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
      }
    },
    "maximumEvidenceAgeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "requiredApproverRole": {
      "type": "string",
      "minLength": 1
    },
    "prohibitRequesterApproval": {
      "type": "boolean"
    },
    "cumulativeLimitScope": {
      "type": "string",
      "enum": [
        "employee",
        "purpose",
        "project"
      ]
    }
  },
  "required": [
    "ruleId",
    "effect",
    "categoryIds",
    "requesterRoles",
    "requireActivePurpose",
    "requiredEvidenceKinds"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/PolicyRuleSchema.schema.json",
  "title": "PolicyRuleSchema",
  "x-alloc-contract-version": "1.0.0"
}
