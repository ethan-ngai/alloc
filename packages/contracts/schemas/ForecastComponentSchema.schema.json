{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "actual_spend",
        "outstanding_commitment",
        "uncommitted_baseline",
        "scenario_adjustment"
      ]
    },
    "amount": {
      "type": "object",
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "const": "USD"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ],
      "additionalProperties": false
    },
    "inputRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "kind",
    "amount",
    "inputRefs"
  ],
  "additionalProperties": false,
  "$id": "https://alloc.local/contracts/1.0.0/ForecastComponentSchema.schema.json",
  "title": "ForecastComponentSchema",
  "x-alloc-contract-version": "1.0.0"
}
