{
  "name": "@alloc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "executor": "node dist/execution/worker.js",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@alloc/contracts": "*",
    "@alloc/financial-rules": "*",
    "@alloc/forecast": "*",
    "@alloc/scheduler": "*",
    "@fastify/cors": "^11.3.0",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "mongodb": "6.21.0",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@alloc/test-support": "*",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
